# === Claude API ===
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Modelos (ajustables según costo/calidad)
COACH_MODEL_MAIN=claude-sonnet-4-6
COACH_MODEL_FAST=claude-haiku-4-5-20251001
COACH_MODEL_EXTRACTOR=claude-sonnet-4-6

# === Qdrant ===
# Modo local (embebido): deja QDRANT_URL vacío, usá QDRANT_PATH
# Modo cloud (Qdrant Cloud): ponelos del dashboard → Clusters → Connect
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./qdrant_storage

# === Ollama ===
# true (local con GPU) | false (cloud, usa Anthropic como fallback)
OLLAMA_ENABLED=true

# === Embeddings ===
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cuda
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# === Whisper ===
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=es

# === Paths ===
DATA_DIR=./data
PROMPTS_DIR=./prompts

# === Logging ===
LOG_LEVEL=INFO
